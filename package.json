{
  "name": "osien-memories",
  "version": "0.0.4",
  "description": "A private, local-first Windows iPhone media studio and organizer.",
  "author": "OSIEN",
  "main": "main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "icons": "node scripts/create-icon.mjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-installer-assets.ps1",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist": "npm run build && npm run icons && electron-builder --win nsis",
    "pack": "npm run build && npm run icons && electron-builder --win dir"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "lucide-react": "^1.77.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.9",
    "minimatch@^10.0.0": "^11.0.9"
  },
  "build": {
    "appId": "com.osien.aplet",
    "productName": "OSIEN Memories",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-dist/**/*",
      "src/**/*",
      "src/importer.cjs",
      "node_modules/exifr/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/phone.ps1"
    ],
    "win": {
      "icon": "src/assets/osien-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerIcon": "src/assets/osien-logo.ico",
      "uninstallerIcon": "src/assets/osien-logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSIEN Memories"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
